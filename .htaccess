# Apache hardening (needs AllowOverride All — set in the Dockerfile)
Options -Indexes -MultiViews
ServerSignature Off

# Never serve internals, backups, schema dumps, dotfiles or docs.
<FilesMatch "(^\.|\.(bak|sql|md|yml|yaml|log|ini|dist|lock|sh)$|^Dockerfile$)">
    Require all denied
</FilesMatch>
<FilesMatch "^\.htaccess$">
    Require all denied
</FilesMatch>

# Include/config files are only ever loaded by PHP itself, not by browsers.
RedirectMatch 404 ^/(admin/)?(includes|config|sql|\.git|\.claude)(/|$)

# Admin and session-bearing pages must never be cached by proxies/browsers.
<IfModule mod_headers.c>
    Header always set Cache-Control "no-store" "expr=%{REQUEST_URI} =~ m#\.php$# || %{REQUEST_URI} == '/'"
    Header always unset X-Powered-By
</IfModule>
